{
  "schema_version": "joint_uci_v5_protocol_v1",
  "protocol_status": "frozen_before_joint_results",
  "target_dataset": "student-mat",
  "auxiliary_dataset": "student-por",
  "identity": {
    "method": "sha256_of_conservative_quasi_identity",
    "group_columns": [
      "school",
      "sex",
      "age",
      "address",
      "famsize",
      "Pstatus",
      "Medu",
      "Fedu",
      "Mjob",
      "Fjob",
      "reason",
      "nursery",
      "internet"
    ],
    "validation_group_in_pretraining": "PROHIBITED"
  },
  "comparison": {
    "scope": "inner_validation_only_inside_each_student_mat_outer_training_partition",
    "outer_folds": 5,
    "inner_folds": 3,
    "seeds": [
      42,
      1201,
      2026,
      3407,
      7319
    ],
    "standalone": "student_mat_only_with_subject_indicator",
    "joint": "combined_subject_pretraining_then_student_mat_finetuning",
    "subject_indicator": [
      "is_mat",
      "is_por"
    ],
    "architecture_and_base_hyperparameters": "reuse_inner_selected_student_mat_outer_fold_configuration",
    "joint_pretraining_epochs": "reuse_selected_fixed_epochs",
    "finetuning_epochs_fraction": 0.5,
    "finetuning_learning_rate_fraction": 0.35,
    "joint_pretraining_imbalance": "none",
    "subject_finetuning_imbalance": "reuse_student_mat_inner_selected_strategy"
  },
  "selection": {
    "primary_metric": "macro_f1",
    "stable_improvement_requires": {
      "positive_mean_delta_for_every_seed": true,
      "positive_mean_delta_in_at_least_outer_folds": 4,
      "overall_mean_delta_strictly_positive": true
    },
    "outer_validation_is_not_used_for_joint_selection": true
  },
  "leakage": {
    "G3_as_input": "PROHIBITED",
    "preprocessing_fit_scope": "current_training_partition_only",
    "same_quasi_student_in_train_and_validation": "PROHIBITED"
  }
}

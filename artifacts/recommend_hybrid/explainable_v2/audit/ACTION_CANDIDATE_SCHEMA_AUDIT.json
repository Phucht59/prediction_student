    "active_day_rate",
    "inactivity_streak",
    "engagement_recovery_possible",
    "unviewed_content",
    "low_coverage_topics"
  ],
  "deterministic_eligibility_rules": {
    "QUIZ_RETRIEVAL_PRACTICE": "quiz_available == True",
    "ASSESSMENT_COMPLETION": "missing_assessment_count > 0 or assessments_due > 0 or due_soon_count > 0",
    "RECOVER_ENGAGEMENT": "inactivity_streak > 0 or active_day_rate < 0.5 or engagement_recovery_possible == True",
    "STUDY_REGULARITY": "regularity_score < 0.8 or study_consistency < 0.8 or active_day_rate < 0.8",
    "TARGETED_CONTENT_REVIEW": "unviewed_content > 0 or low_coverage_topics > 0 or content_coverage < 0.8"
  }

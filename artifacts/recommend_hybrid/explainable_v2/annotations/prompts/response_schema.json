{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExplainableV2ExternalLLMAnnotationResponseSchemaV3",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id",
    "panel_id",
    "action_id",
    "relevance_score",
    "abstain",
    "evidence_ids",
    "rationale",
    "contraindication_detected",
    "safety_flag",
    "reviewer_id",
    "reviewer_configuration_id",
    "reviewer_type",
    "provider",
    "model_name",
    "request_id",
    "response_id",
    "batch_id",
    "prompt_version",
    "prompt_sha256",
    "request_batch_sha256",
    "raw_request_sha256",
    "raw_response_sha256",
    "response_record_index",
    "response_record_sha256",
    "created_at"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^case_[a-f0-9]{24}$"
    },
    "panel_id": {
      "type": "string",
      "enum": ["PANEL_A", "PANEL_B"]
    },
    "action_id": {
      "type": "string",
      "enum": [
        "ASSESSMENT_COMPLETION",
        "RECOVER_ENGAGEMENT",
        "STUDY_REGULARITY",
        "TARGETED_CONTENT_REVIEW",
        "QUIZ_RETRIEVAL_PRACTICE"
      ]
    },
    "relevance_score": {
      "type": "integer",
      "enum": [0, 1, 2, 3]
    },
    "abstain": {
      "type": "boolean"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "contraindication_detected": {
      "type": "boolean"
    },
    "safety_flag": {
      "type": "boolean"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_type": {
      "type": "string",
      "enum": ["REAL_EXTERNAL_LLM_REVIEW"]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": ["string", "null"]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "response_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_batch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_response_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_record_index": {
      "type": "integer",
      "minimum": 0
    },
    "response_record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
